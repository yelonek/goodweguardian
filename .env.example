# ── GoodWeGuardian: konfiguracja ─────────────────────────────────────────────
# .env trzyma WYŁĄCZNIE infrastrukturę / sekrety (czytane przy starcie procesu,
# zmiana = RESTART). Skopiuj do .env i uzupełnij.
#
# Pokrętła strojenia (obrony SOC, taryfy, soak, nowcast, korekta PV, ekonomia
# planera, RCE, ...) NIE są w .env. Jedno źródło prawdy to dashboard → zakładka
# Ustawienia / onboarding, zapis do state/settings.json (BEZ restartu). Pełną
# listę pól, opisy i zakresy widać w dashboardzie oraz w guardian_settings.py.

# ── INFRASTRUKTURA / BOOTSTRAP (wymaga restartu) ─────────────────────────────
# Adres inwertera GoodWe (LAN).
INVERTER_IP=192.168.1.23
# Host Tesla Wall Connector (opcjonalnie; puste = brak integracji EV).
TESLA_WC_HOST=192.168.1.120
# Numer eco slotu zarezerwowanego dla Guardiana (1..4).
ECO_SLOT_BALANCING=4
# Moc znamionowa inwertera / baterii [W] (sprzęt).
P_INVERTER=8200
P_BATTERY=5200
# Klucz do API kontrolnego dashboardu (bez niego endpointy zapisu zwracają 401/503).
GUARDIAN_API_KEY=zmien-mnie
# Główny przełącznik zapisów do inwertera (nadpisywalny w runtime plikiem override).
GUARDIAN_CONTROL_ENABLED=1
# Czy Guardian stosuje plan (nadpisywalny w runtime).
# PLANNER_EXECUTION_ENABLED=1
# Telemetria: 1 = zapisuj linie JSONL; strefa czasowa slotów/bilansu.
# TELEMETRY_ENABLED=1
# TELEMETRY_TZ=Europe/Warsaw
# Proxy prognoz i cen (puste = fallback do publicznego API PSE / brak PV proxy).
SOLCAST_PROXY_BASE_URL=http://192.168.1.194:8080
RCE_PROXY_BASE_URL=http://192.168.1.194:18000/
# OpenWeatherMap One Call 3.0 — eksperymentalna korekta PV (Tier1: clouds/uvi/pop/weather).
# Wymaga osobnej subskrypcji One Call (1000 calls/day gratis). Puste key = skip.
# OPENWEATHER_API_KEY=
# OPENWEATHER_LAT=52.23
# OPENWEATHER_LON=21.01
# OPENWEATHER_CACHE_TTL_S=900
# PV_WEATHER_CORRECTION_ENABLED=1
